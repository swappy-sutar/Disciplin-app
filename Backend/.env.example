# Server Port
PORT=5000

# MongoDB Connection URI
# For local MongoDB: mongodb://127.0.0.1:27017/disciplin-app
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/disciplin-app
MONGODB_URI=mongodb://127.0.0.1:27017/disciplin-app

# JWT Configuration
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Environment (development, production, test)
NODE_ENV=development
